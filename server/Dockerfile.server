# Stage 1: install dependencies with workspace context
FROM oven/bun:1.3.11 AS bun-runtime
FROM node:20 AS deps

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun

# Install build dependencies
RUN apt-get update && apt-get install -y python3 ffmpeg make g++ build-essential && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches

RUN mkdir -p packages/happyherd-app packages/happyherd-server packages/happyherd-cli packages/happyherd-wire

COPY packages/happyherd-app/package.json packages/happyherd-app/
COPY packages/happyherd-server/package.json packages/happyherd-server/
COPY packages/happyherd-cli/package.json packages/happyherd-cli/
COPY packages/happyherd-wire/package.json packages/happyherd-wire/

# Workspace postinstall requirements
COPY packages/happyherd-app/patches packages/happyherd-app/patches
COPY packages/happyherd-app/scripts/setup-pdfjs-web.mjs packages/happyherd-app/scripts/setup-pdfjs-web.mjs
COPY packages/happyherd-server/prisma packages/happyherd-server/prisma
COPY packages/happyherd-cli/scripts packages/happyherd-cli/scripts
COPY packages/happyherd-cli/tools packages/happyherd-cli/tools

RUN SKIP_HAPPYHERD_WIRE_BUILD=1 pnpm install --frozen-lockfile

# Stage 2: build the server
FROM deps AS builder

COPY packages/happyherd-wire ./packages/happyherd-wire
COPY packages/happyherd-server ./packages/happyherd-server

RUN pnpm --filter @happyherd/wire --fail-if-no-match build
RUN pnpm --filter happyherd-server --fail-if-no-match build

# Stage 3: runtime
FROM node:20 AS runner

WORKDIR /repo

# Runtime dependencies
RUN apt-get update && apt-get install -y python3 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

# Set environment to production
ENV NODE_ENV=production

# Copy necessary files from the builder stage
COPY --from=builder /repo/node_modules /repo/node_modules
COPY --from=builder /repo/packages/happyherd-wire /repo/packages/happyherd-wire
COPY --from=builder /repo/packages/happyherd-server /repo/packages/happyherd-server

# Expose the port the app will run on
EXPOSE 3000

# Command to run the application
COPY --from=builder /repo/package.json /repo/pnpm-workspace.yaml /repo/
WORKDIR /repo/packages/happyherd-server
CMD ["pnpm", "run", "start"]

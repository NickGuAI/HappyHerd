{
  "name": "@happyherd/happyherd-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Generic governed Discord-to-HappyHerd agent runtime",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "happy-agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.11.0"
}

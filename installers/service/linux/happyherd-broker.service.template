[Unit]
Description=HappyHerd credential and Skill broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0027
LoadCredentialEncrypted=happyherd-keyring-password:@KEYRING_CREDENTIAL@
RuntimeDirectory=happyherd-@OWNER_UID@
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/dbus-run-session -- "@SECRET_SERVICE_WRAPPER@" "@NODE_RUNTIME@" "@BROKER_SCRIPT@" "@SERVICE_CONFIG@" "@STATE_ROOT@"
Restart=on-failure
RestartSec=3
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

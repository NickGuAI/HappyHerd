[Unit]
Description=HappyHerd credential and Skill broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0027
LoadCredentialEncrypted=happyherd-keyring-password:@KEYRING_CREDENTIAL@
RuntimeDirectory=happyherd-@OWNER_UID@
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/dbus-run-session -- "@SECRET_SERVICE_WRAPPER@" "@NODE_RUNTIME@" "@BROKER_SCRIPT@" "@SERVICE_CONFIG@" "@STATE_ROOT@"
Restart=on-failure
RestartSec=3
PrivateTmp=true
PrivateMounts=true
ProtectSystem=full
ProtectHome=false
ProtectControlGroups=true
# The broker's root-owned launcher validates this service identity, reads only
# root-private configuration, then immediately drops to the isolated tool UID.
# NoNewPrivileges and every option that implies it must remain disabled here;
# otherwise the launcher's guarded setuid transition is unavailable.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target

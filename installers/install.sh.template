  [ "$(sudo /usr/bin/stat -f '%z:%l' "$keychain_master_path")" = '64:1' ] || fail 'macOS Keychain unlock master shape is unsafe'
  printf 'HappyHerd initialized the headless macOS credential vault.\n'
fi
capability_path="$state_root/client-capability"
private_key_path="$state_root/signing-private.pem"
service_config="$state_root/broker-service.json"
if sudo test -e "$service_config"; then
  if ! sudo test -f "$service_config" || sudo test -L "$service_config"; then
    fail 'existing broker service configuration is unsafe'
  fi
  service_config_metadata=$(protected_metadata "$service_config")
  [ "$service_config_metadata" = "$service_uid:$service_gid:600" ] || fail 'existing broker service configuration ownership or mode is unsafe'
  sudo cp "$service_config" "$root_stage/service-config.previous"
fi

if sudo test -e "$capability_path"; then
  if ! sudo test -f "$capability_path" || sudo test -L "$capability_path"; then
    fail 'existing broker capability is unsafe'
  fi
  [ "$(protected_metadata "$capability_path")" = "$service_uid:$service_gid:600" ] || fail 'existing broker capability ownership or mode is unsafe'
fi
if sudo test -e "$private_key_path"; then
  if ! sudo test -f "$private_key_path" || sudo test -L "$private_key_path"; then
    fail 'existing broker signing key is unsafe'
  fi
  [ "$(protected_metadata "$private_key_path")" = "$service_uid:$service_gid:600" ] || fail 'existing broker signing key ownership or mode is unsafe'
fi
if ! sudo test -f "$capability_path" || ! sudo test -f "$private_key_path"; then
  key_stage="$root_stage/key-stage"
  sudo mkdir -m 700 "$key_stage"
  sudo "$install_dir/native/node" - "$key_stage" <<'NODE'
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const root=process.argv[2];
const keys=crypto.generateKeyPairSync('ed25519');
fs.writeFileSync(path.join(root,'client-capability'),crypto.randomBytes(32).toString('hex')+'\n',{mode:0o600,flag:'wx'});
fs.writeFileSync(path.join(root,'signing-private.pem'),keys.privateKey.export({type:'pkcs8',format:'pem'}),{mode:0o600,flag:'wx'});
NODE
  sudo install -o "$service_user" -g "$service_group" -m 600 "$key_stage/client-capability" "$capability_path"
  sudo install -o "$service_user" -g "$service_group" -m 600 "$key_stage/signing-private.pem" "$private_key_path"
fi
capability=$(sudo "$install_dir/native/node" -e "process.stdout.write(require('node:fs').readFileSync(process.argv[1],'utf8').trim())" "$capability_path")

if [ "$platform" = linux ]; then
  credential_root=/etc/happyherd/credentials
  sudo /usr/bin/install -d -o root -g root -m 700 "$credential_root"
  sudo test ! -L "$credential_root" || fail 'encrypted credential directory must not be a symbolic link'
  if sudo test -e "$keyring_credential"; then
    if ! sudo test -f "$keyring_credential" || sudo test -L "$keyring_credential"; then
      fail 'existing encrypted keyring credential is unsafe'
    fi

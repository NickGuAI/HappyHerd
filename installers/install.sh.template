        | /usr/bin/systemd-creds encrypt \
            --with-key=host \
            --name=happyherd-keyring-password \
            - "$2" >/dev/null
    ' sh "$install_dir/native/node" "$keyring_encrypted"
    sudo test -s "$keyring_encrypted" || fail 'systemd did not produce an encrypted keyring credential'
    sudo /usr/bin/install -o root -g root -m 600 "$keyring_encrypted" "$keyring_credential"
    new_keyring_credential=1
  fi
fi

sudo mkdir -p "$(dirname "$tool_launcher_config")"
HAPPYHERD_BROKER_UID="$service_uid" HAPPYHERD_TOOL_UID="$tool_uid" HAPPYHERD_TOOL_GID="$tool_gid" \

    fail 'existing broker state root is unsafe'
  fi
  had_state=1
fi

if [ "$platform" = linux ]; then
  if getent passwd "$service_user" >/dev/null; then
    existing_home=$(getent passwd "$service_user" | cut -d: -f6)
    existing_shell=$(getent passwd "$service_user" | cut -d: -f7)
    existing_marker=$(getent passwd "$service_user" | cut -d: -f5)
    existing_gid=$(id -g "$service_user")
    existing_groups=$(id -G "$service_user")
    existing_group_name=$(getent group "$existing_gid" | cut -d: -f1)
    if ! { [ "$existing_home" = "$state_root" ] \
      && [ "$existing_shell" = /usr/sbin/nologin ] \
      && [ "$existing_marker" = "$service_marker" ] \
      && [ "$existing_groups" = "$existing_gid" ] \
      && [ "$existing_group_name" = "$service_group" ]; }; then
      fail 'existing broker service identity is not owned by this HappyHerd installation'
    fi
  else
    sudo useradd --system --user-group --comment "$service_marker" --home-dir "$state_root" --create-home --shell /usr/sbin/nologin "$service_user"
    new_service_identity=1
  fi
  service_uid=$(id -u "$service_user")
  service_gid=$(id -g "$service_user")
  [ "$service_uid" -ne "$owner_uid" ] || fail 'broker service identity overlaps the target user'
  if getent passwd "$tool_user" >/dev/null; then
    tool_home=$(getent passwd "$tool_user" | cut -d: -f6)
    tool_shell=$(getent passwd "$tool_user" | cut -d: -f7)
    tool_existing_marker=$(getent passwd "$tool_user" | cut -d: -f5)
    tool_existing_gid=$(id -g "$tool_user")
    tool_existing_groups=$(id -G "$tool_user")
    if ! { [ "$tool_home" = /nonexistent ] \
      && [ "$tool_shell" = /usr/sbin/nologin ] \
      && [ "$tool_existing_marker" = "$tool_marker" ] \
      && [ "$tool_existing_gid" = "$service_gid" ] \
      && [ "$tool_existing_groups" = "$service_gid" ]; }; then
      fail 'existing tool execution identity is not owned by this HappyHerd installation'
    fi
  else
    sudo useradd --system --gid "$service_group" --comment "$tool_marker" --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin "$tool_user"
    new_tool_identity=1
  fi
  tool_uid=$(id -u "$tool_user")
  tool_gid=$(id -g "$tool_user")
else
  service_user_exists=0
  service_group_exists=0
  if dscl . -read "/Users/$service_user" >/dev/null 2>&1; then service_user_exists=1; fi
  if dscl . -read "/Groups/$service_group" >/dev/null 2>&1; then service_group_exists=1; fi
  if [ "$service_user_exists" -ne "$service_group_exists" ]; then
    fail 'macOS broker service user/group namespace is incomplete or conflicts with another installation'
  fi
  if [ "$service_user_exists" -eq 1 ]; then
    existing_home=$(dscl . -read "/Users/$service_user" NFSHomeDirectory | sed 's/^[^:]*: //')
    [ "$existing_home" = "$state_root" ] || fail 'existing broker service user has an unexpected home'
    existing_shell=$(dscl . -read "/Users/$service_user" UserShell | sed 's/^[^:]*: //')
    [ "$existing_shell" = /usr/bin/false ] || fail 'existing broker service user has an unsafe login shell'
    existing_hidden=$(dscl . -read "/Users/$service_user" IsHidden | sed 's/^[^:]*: //')
    [ "$existing_hidden" = 1 ] || fail 'existing broker service user is not hidden'
    existing_password=$(dscl . -read "/Users/$service_user" Password | sed 's/^[^:]*: //')
    [ "$existing_password" = '*' ] || fail 'existing broker service user password is not disabled'
    existing_generated_uid=$(dscl . -read "/Users/$service_user" GeneratedUID | sed 's/^[^:]*: //')
    printf '%s\n' "$existing_generated_uid" | /usr/bin/grep -Eq '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$' \
      || fail 'existing broker service user has an invalid generated identity'
    existing_marker=$(dscl . -read "/Users/$service_user" RealName | sed 's/^[^:]*: //')
    [ "$existing_marker" = "$service_marker" ] || fail 'existing broker service user marker is unsafe'
    existing_gid=$(dscl . -read "/Users/$service_user" PrimaryGroupID | sed 's/^[^:]*: //')
    group_gid=$(dscl . -read "/Groups/$service_group" PrimaryGroupID 2>/dev/null | sed 's/^[^:]*: //')
    group_marker=$(dscl . -read "/Groups/$service_group" RealName 2>/dev/null | sed 's/^[^:]*: //')
    if [ "$existing_gid" != "$group_gid" ] || [ "$group_marker" != "$service_marker group" ]; then fail 'existing broker service group is unsafe'; fi
    if sudo dseditgroup -o checkmember -m "$service_user" admin | /usr/bin/grep -Fq 'yes'; then fail 'broker service identity must not be an administrator'; fi
  else
    next_gid=$(mac_next_identity_id)
    mac_create_record "/Groups/$service_group" 'broker service group'
    new_service_group=1
    mac_create_attribute "/Groups/$service_group" PrimaryGroupID "$next_gid" 'broker service group'
    mac_create_attribute "/Groups/$service_group" RealName "$service_marker group" 'broker service group'
    mac_create_attribute "/Groups/$service_group" GeneratedUID "$(uuidgen)" 'broker service group'
    next_id=$(mac_next_identity_id)
    mac_create_record "/Users/$service_user" 'broker service user'
    new_service_user=1
    mac_create_attribute "/Users/$service_user" UniqueID "$next_id" 'broker service user'
    mac_create_attribute "/Users/$service_user" PrimaryGroupID "$next_gid" 'broker service user'
    mac_create_attribute "/Users/$service_user" NFSHomeDirectory "$state_root" 'broker service user'
    mac_create_attribute "/Users/$service_user" UserShell /usr/bin/false 'broker service user'
    mac_create_attribute "/Users/$service_user" RealName "$service_marker" 'broker service user'
    mac_create_attribute "/Users/$service_user" IsHidden 1 'broker service user'
    mac_disable_password "/Users/$service_user" 'broker service user'
    service_generated_uid=$(uuidgen)
    mac_create_attribute "/Users/$service_user" GeneratedUID "$service_generated_uid" 'broker service user'
    created_service_home=$(dscl . -read "/Users/$service_user" NFSHomeDirectory | sed 's/^[^:]*: //') || fail 'created broker service user home could not be verified'
    created_service_shell=$(dscl . -read "/Users/$service_user" UserShell | sed 's/^[^:]*: //') || fail 'created broker service user shell could not be verified'
    created_service_hidden=$(dscl . -read "/Users/$service_user" IsHidden | sed 's/^[^:]*: //') || fail 'created broker service user hidden state could not be verified'
    created_service_password=$(dscl . -read "/Users/$service_user" Password | sed 's/^[^:]*: //') || fail 'created broker service user password state could not be verified'
    created_service_generated_uid=$(dscl . -read "/Users/$service_user" GeneratedUID | sed 's/^[^:]*: //') || fail 'created broker service user generated identity could not be verified'
    created_service_marker=$(dscl . -read "/Users/$service_user" RealName | sed 's/^[^:]*: //') || fail 'created broker service user marker could not be verified'
    created_service_gid=$(dscl . -read "/Users/$service_user" PrimaryGroupID | sed 's/^[^:]*: //') || fail 'created broker service user group could not be verified'
    created_service_uid=$(dscl . -read "/Users/$service_user" UniqueID | sed 's/^[^:]*: //') || fail 'created broker service user ID could not be verified'
    created_group_gid=$(dscl . -read "/Groups/$service_group" PrimaryGroupID | sed 's/^[^:]*: //') || fail 'created broker service group ID could not be verified'
    created_group_marker=$(dscl . -read "/Groups/$service_group" RealName | sed 's/^[^:]*: //') || fail 'created broker service group marker could not be verified'
    if ! { [ "$created_service_home" = "$state_root" ] \
      && [ "$created_service_shell" = /usr/bin/false ] \
      && [ "$created_service_hidden" = 1 ] \
      && [ "$created_service_password" = '*' ] \
      && [ "$created_service_generated_uid" = "$service_generated_uid" ] \
      && [ "$created_service_marker" = "$service_marker" ] \
      && [ "$created_service_gid" = "$next_gid" ] \
      && [ "$created_service_uid" = "$next_id" ] \
      && [ "$created_group_gid" = "$next_gid" ] \
      && [ "$created_group_marker" = "$service_marker group" ]; }; then
      fail 'created broker service identity failed exact read-back verification'
    fi
    if sudo dseditgroup -o checkmember -m "$service_user" admin | /usr/bin/grep -Fq 'yes'; then fail 'broker service identity must not be an administrator'; fi
    new_service_identity=1
  fi
  service_uid=$(id -u "$service_user")
  service_gid=$(id -g "$service_user")
  if dscl . -read "/Users/$tool_user" >/dev/null 2>&1; then
    tool_home=$(dscl . -read "/Users/$tool_user" NFSHomeDirectory | sed 's/^[^:]*: //')
    tool_shell=$(dscl . -read "/Users/$tool_user" UserShell | sed 's/^[^:]*: //')
    tool_hidden=$(dscl . -read "/Users/$tool_user" IsHidden | sed 's/^[^:]*: //')
    tool_password=$(dscl . -read "/Users/$tool_user" Password | sed 's/^[^:]*: //')
    tool_generated_uid=$(dscl . -read "/Users/$tool_user" GeneratedUID | sed 's/^[^:]*: //')
    printf '%s\n' "$tool_generated_uid" | /usr/bin/grep -Eq '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$' \
      || fail 'existing tool execution user has an invalid generated identity'
    tool_existing_marker=$(dscl . -read "/Users/$tool_user" RealName | sed 's/^[^:]*: //')
    tool_existing_gid=$(dscl . -read "/Users/$tool_user" PrimaryGroupID | sed 's/^[^:]*: //')
    if ! { [ "$tool_home" = /var/empty ] \
      && [ "$tool_shell" = /usr/bin/false ] \
      && [ "$tool_hidden" = 1 ] \
      && [ "$tool_password" = '*' ] \
      && [ "$tool_existing_marker" = "$tool_marker" ] \
      && [ "$tool_existing_gid" = "$service_gid" ]; }; then
      fail 'existing tool execution user is unsafe'
    fi
  else
    next_tool_id=$(mac_next_identity_id)
    mac_create_record "/Users/$tool_user" 'isolated tool user'
    new_tool_user=1
    mac_create_attribute "/Users/$tool_user" UniqueID "$next_tool_id" 'isolated tool user'
    mac_create_attribute "/Users/$tool_user" PrimaryGroupID "$service_gid" 'isolated tool user'
    mac_create_attribute "/Users/$tool_user" NFSHomeDirectory /var/empty 'isolated tool user'
    mac_create_attribute "/Users/$tool_user" UserShell /usr/bin/false 'isolated tool user'
    mac_create_attribute "/Users/$tool_user" RealName "$tool_marker" 'isolated tool user'
    mac_create_attribute "/Users/$tool_user" IsHidden 1 'isolated tool user'
    mac_disable_password "/Users/$tool_user" 'isolated tool user'
    tool_generated_uid=$(uuidgen)
    mac_create_attribute "/Users/$tool_user" GeneratedUID "$tool_generated_uid" 'isolated tool user'
    created_tool_home=$(dscl . -read "/Users/$tool_user" NFSHomeDirectory | sed 's/^[^:]*: //') || fail 'created isolated tool user home could not be verified'
    created_tool_shell=$(dscl . -read "/Users/$tool_user" UserShell | sed 's/^[^:]*: //') || fail 'created isolated tool user shell could not be verified'
    created_tool_hidden=$(dscl . -read "/Users/$tool_user" IsHidden | sed 's/^[^:]*: //') || fail 'created isolated tool user hidden state could not be verified'
    created_tool_password=$(dscl . -read "/Users/$tool_user" Password | sed 's/^[^:]*: //') || fail 'created isolated tool user password state could not be verified'
    created_tool_generated_uid=$(dscl . -read "/Users/$tool_user" GeneratedUID | sed 's/^[^:]*: //') || fail 'created isolated tool user generated identity could not be verified'
    created_tool_marker=$(dscl . -read "/Users/$tool_user" RealName | sed 's/^[^:]*: //') || fail 'created isolated tool user marker could not be verified'
    created_tool_gid=$(dscl . -read "/Users/$tool_user" PrimaryGroupID | sed 's/^[^:]*: //') || fail 'created isolated tool user group could not be verified'
    created_tool_uid=$(dscl . -read "/Users/$tool_user" UniqueID | sed 's/^[^:]*: //') || fail 'created isolated tool user ID could not be verified'
    if ! { [ "$created_tool_home" = /var/empty ] \
      && [ "$created_tool_shell" = /usr/bin/false ] \
      && [ "$created_tool_hidden" = 1 ] \
      && [ "$created_tool_password" = '*' ] \
      && [ "$created_tool_generated_uid" = "$tool_generated_uid" ] \
      && [ "$created_tool_marker" = "$tool_marker" ] \
      && [ "$created_tool_gid" = "$service_gid" ] \
      && [ "$created_tool_uid" = "$next_tool_id" ]; }; then
      fail 'created isolated tool identity failed exact read-back verification'
    fi
    new_tool_identity=1
  fi
  if sudo dseditgroup -o checkmember -m "$tool_user" admin | /usr/bin/grep -Fq 'yes'; then fail 'tool execution identity must not be an administrator'; fi
  tool_uid=$(id -u "$tool_user")
  tool_gid=$(id -g "$tool_user")
fi
service_identity="$service_identity_prefix:$service_uid"
tool_identity="$service_identity_prefix:$tool_uid"
if [ "$tool_uid" -eq "$owner_uid" ] || [ "$tool_uid" -eq "$service_uid" ]; then fail 'tool execution identity overlaps a trusted identity'; fi

if [ "$had_state" -eq 1 ]; then
  state_metadata=$(protected_metadata "$state_root") || fail 'existing broker state root metadata is unavailable'

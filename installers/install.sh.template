#!/bin/sh
set -eu

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
unset NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS SSL_CERT_FILE SSL_CERT_DIR HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy HAPPYHERD_ACCESS_TOKEN

release_base='@RELEASE_BASE_URL@'
release_version='@RELEASE_VERSION@'

fail() {
  printf 'happyherd installer: %s\n' "$*" >&2
  exit 1
}

local_manifest=''
local_asset=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --local-manifest)
      if [ "$#" -lt 2 ] || [ -n "$local_manifest" ]; then fail 'local manifest argument is incomplete or duplicated'; fi
      local_manifest=$2; shift 2 ;;
    --local-asset)
      if [ "$#" -lt 2 ] || [ -n "$local_asset" ]; then fail 'local asset argument is incomplete or duplicated'; fi
      local_asset=$2; shift 2 ;;
    *) fail "unsupported installer argument: $1" ;;
  esac
done
if [ -n "$local_manifest" ] || [ -n "$local_asset" ]; then
  if [ -z "$local_manifest" ] || [ -z "$local_asset" ]; then fail 'local manifest and local asset must be supplied together'; fi
  case "$local_manifest:$local_asset" in /*:/*) ;; *) fail 'local manifest and local asset paths must be absolute' ;; esac
  if [ ! -f "$local_manifest" ] || [ -L "$local_manifest" ]; then fail 'local release manifest is not a regular file'; fi
  if [ ! -f "$local_asset" ] || [ -L "$local_asset" ]; then fail 'local release asset is not a regular file'; fi
fi

for command_name in sudo tar; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command not found: $command_name"
done
[ -n "$local_manifest" ] || command -v curl >/dev/null 2>&1 || fail 'required command not found: curl'
[ "$(id -u)" -ne 0 ] || fail 'run this installer as the target user; it will request sudo only for service setup'
sudo -v || fail 'administrator access is required to install the isolated broker service'

owner_user=$(id -un)
owner_uid=$(id -u)
case "$owner_user" in ''|*[!A-Za-z0-9._-]*) fail 'target user name is unsafe' ;; esac
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)
    platform=darwin; target=darwin-arm64
    asset_name='@DARWIN_ARM64_FILENAME@'; asset_sha='@DARWIN_ARM64_SHA256@'; asset_size='@DARWIN_ARM64_SIZE@'; source_sha='@DARWIN_ARM64_SOURCE_SHA@' ;;
  Darwin-x86_64)
    platform=darwin; target=darwin-x64
    asset_name='@DARWIN_X64_FILENAME@'; asset_sha='@DARWIN_X64_SHA256@'; asset_size='@DARWIN_X64_SIZE@'; source_sha='@DARWIN_X64_SOURCE_SHA@' ;;
  Linux-aarch64|Linux-arm64)
    platform=linux; target=linux-arm64
    asset_name='@LINUX_ARM64_FILENAME@'; asset_sha='@LINUX_ARM64_SHA256@'; asset_size='@LINUX_ARM64_SIZE@'; source_sha='@LINUX_ARM64_SOURCE_SHA@' ;;
  Linux-x86_64)
    platform=linux; target=linux-x64
    asset_name='@LINUX_X64_FILENAME@'; asset_sha='@LINUX_X64_SHA256@'; asset_size='@LINUX_X64_SIZE@'; source_sha='@LINUX_X64_SOURCE_SHA@' ;;
  *) fail "unsupported platform: $(uname -s)-$(uname -m)" ;;
esac

service_marker="HappyHerd broker for UID $owner_uid"
tool_marker="HappyHerd isolated tool runner for UID $owner_uid"
if [ "$platform" = linux ]; then
  linux_prerequisites=''
  for command_name in setfacl getfacl dbus-run-session gnome-keyring-daemon; do
    command -v "$command_name" >/dev/null 2>&1 || linux_prerequisites="$linux_prerequisites $command_name"
  done
  if [ -n "$linux_prerequisites" ]; then
    printf 'HappyHerd is installing required Linux service packages:%s\n' "$linux_prerequisites"
    if [ -x /usr/bin/apt-get ]; then
      sudo /usr/bin/apt-get update
      sudo env DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install --yes --no-install-recommends acl dbus-daemon gnome-keyring
    elif [ -x /usr/bin/dnf ]; then
      sudo /usr/bin/dnf install -y acl dbus-daemon gnome-keyring
    elif [ -x /usr/bin/yum ]; then
      sudo /usr/bin/yum install -y acl dbus-daemon gnome-keyring
    else
      fail "required Linux service commands are missing:$linux_prerequisites; install acl, dbus-daemon, and gnome-keyring"
    fi
  fi
  for command_name in systemctl useradd userdel groupdel setfacl getfacl getent sha256sum dbus-run-session gnome-keyring-daemon systemd-creds; do
    command -v "$command_name" >/dev/null 2>&1 || fail "required broker service command not found: $command_name"
  done
  for command_path in /usr/bin/dbus-run-session /usr/bin/gnome-keyring-daemon /usr/bin/systemd-creds; do
    [ -x "$command_path" ] || fail "required broker service component is unavailable: $command_path"
  done
  install_dir="/opt/happyherd/$owner_uid"
  state_root="/var/lib/happyherd/$owner_uid"
  service_user="happyherd-$owner_uid"
  tool_user="happyherd-tool-$owner_uid"
  service_group="$service_user"
  service_name="happyherd-broker-$owner_uid.service"
  service_definition="/etc/systemd/system/$service_name"
  tool_launcher_config="/etc/happyherd/tool-launcher-$owner_uid.conf"
  keyring_credential="/etc/happyherd/credentials/keyring-$owner_uid.cred"
  service_identity_prefix=uid
  owner_home=$(getent passwd "$owner_user" | cut -d: -f6)
else
  for command_name in dscl dseditgroup dscacheutil launchctl shasum uuidgen; do
    command -v "$command_name" >/dev/null 2>&1 || fail "required broker service command not found: $command_name"
  done
  install_dir="/Library/Application Support/HappyHerd/$owner_uid"
  state_root="/Library/Application Support/HappyHerd/Broker/$owner_uid"
  # Leading-underscore names are macOS role accounts and are incompatible with
  # the collision-resistant high UIDs used here. Keep these as hidden local
  # accounts instead; the disabled password and false shell remain fail closed.
  service_user="happyherd$owner_uid"
  tool_user="happyherdtool$owner_uid"
  service_group="$service_user"
  service_name="dev.happyherd.broker.$owner_uid"
  service_definition="/Library/LaunchDaemons/$service_name.plist"
  tool_launcher_config="/Library/Application Support/HappyHerd/tool-launcher-$owner_uid.conf"
  keychain_host="/Library/PrivilegedHelperTools/dev.happyherd.keychain-broker-$owner_uid"
  keychain_path="$state_root/Library/Keychains/happyherd.keychain-db"
  keychain_master_dir="/Library/Application Support/HappyHerd/Secrets/$owner_uid"
  keychain_master_path="$keychain_master_dir/keychain-master"
  service_identity_prefix=uid
  owner_home=$(dscl . -read "/Users/$owner_user" NFSHomeDirectory | sed 's/^[^:]*: //')
fi
case "$owner_home" in ''|'/') fail 'target user home is unsafe' ;; esac

bin_dir="$owner_home/.local/bin"
link_path="$bin_dir/happyherd"
client_dir="$install_dir/client"
client_config="$client_dir/broker.json"
claude_skills="$owner_home/.claude/skills"
codex_skills="$owner_home/.codex/skills"
backup="${install_dir}.previous"
install_parent=$(dirname "$install_dir")
state_parent=$(dirname "$state_root")

protected_metadata() {
  if [ "$platform" = linux ]; then sudo /usr/bin/stat -c '%u:%g:%a' -- "$1"
  else sudo /usr/bin/stat -f '%u:%g:%Lp' "$1"; fi
}

protected_mode() {
  metadata=$(protected_metadata "$1") || return 1
  metadata_uid=${metadata%%:*}; metadata_rest=${metadata#*:}
  metadata_gid=${metadata_rest%%:*}; metadata_mode=${metadata_rest#*:}
  [ -n "$metadata_uid" ] && [ -n "$metadata_gid" ] && [ -n "$metadata_mode" ] || return 1
  case "$metadata_uid:$metadata_gid:$metadata_mode" in *[!0-9:]*) return 1 ;; esac
  [ "$metadata_uid" -eq 0 ] || return 1
  mode_value=$((0$metadata_mode))
  [ $((mode_value & 2)) -eq 0 ] || return 1
  if [ $((mode_value & 16)) -ne 0 ]; then
    [ "${2:-strict}" = trusted-admin-group ] && { [ "$metadata_gid" -eq 0 ] || [ "$metadata_gid" -eq 80 ]; } || return 1
  fi
}

protected_directory() {
  sudo test -d "$1" && sudo test ! -L "$1" && protected_mode "$1" "${2:-strict}"
}

protected_regular() {
  sudo test -f "$1" && sudo test ! -L "$1" && protected_mode "$1" strict || return 1
  [ "${2:-data}" != executable ] || sudo test -x "$1"
}

protected_client_config() {
  path=$1
  sudo test -f "$path" && sudo test ! -L "$path" || return 1
  if [ "$platform" = linux ]; then
    [ "$(protected_metadata "$path")" = '0:0:640' ] || return 1
    client_acl=$(sudo /usr/bin/getfacl --absolute-names --numeric --omit-header -- "$path") || return 1
    expected_acl=$(printf 'user::rw-\nuser:%s:r--\ngroup::---\nmask::r--\nother::---' "$owner_uid")
    [ "$client_acl" = "$expected_acl" ]
  else
    [ "$(protected_metadata "$path")" = '0:0:600' ] || return 1
    client_acl=$(sudo /bin/ls -lde "$path") || return 1
    client_acl_count=$(printf '%s\n' "$client_acl" | /usr/bin/grep -Ec '^[[:space:]]*[0-9]+:')
    [ "$client_acl_count" -eq 1 ] \
      && printf '%s\n' "$client_acl" | /usr/bin/grep -Eq "^[[:space:]]*0: user:$owner_user allow read[[:space:]]*$"
  fi
}

prepare_trust_roots() {
  if [ "$platform" = linux ]; then
    protected_directory /opt || fail '/opt is not an administrator-protected directory'
    protected_directory /var || fail '/var is not an administrator-protected directory'
    protected_directory /var/lib || fail '/var/lib is not an administrator-protected directory'
  else
    protected_directory /Library || fail '/Library is not an administrator-protected directory'
    protected_directory '/Library/Application Support' trusted-admin-group || fail 'Application Support is not administrator-protected'
  fi
  if sudo test -e "$install_parent"; then
    protected_directory "$install_parent" || fail 'HappyHerd install parent is unsafe'
  else
    sudo /usr/bin/install -d -o root -g "$( [ "$platform" = darwin ] && printf wheel || printf root )" -m 755 "$install_parent"
  fi
  if sudo test -e "$state_parent"; then
    protected_directory "$state_parent" || fail 'HappyHerd state parent is unsafe'
  else
    sudo /usr/bin/install -d -o root -g "$( [ "$platform" = darwin ] && printf wheel || printf root )" -m 755 "$state_parent"
  fi
}

verify_install_tree() {
  candidate=$1
  protected_directory "$candidate" \
    && protected_directory "$candidate/native" \
    && protected_regular "$candidate/release.json" \
    && protected_regular "$candidate/native/node" executable
}

owned_install() {
  verify_install_tree "$1" || return 1
  sudo env -i "$1/native/node" - "$1/release.json" <<'NODE'
const fs=require('node:fs');try{const bytes=fs.readFileSync(process.argv[2]);if(bytes.length>65536)process.exit(1);const r=JSON.parse(bytes.toString('utf8'));if(r.schemaVersion!==1||r.product!=='HappyHerd'||r.nodeRuntime!=='native/node'||typeof r.sourceSha!=='string'||!/^[0-9a-f]{40}$/.test(r.sourceSha))process.exit(1)}catch{process.exit(1)}
NODE
}

mac_identity_id_in_use() {
  candidate=$1
  if dscl . -search /Users UniqueID "$candidate" 2>/dev/null | /usr/bin/grep -Eq '[[:space:]]'; then return 0; fi
  if dscl . -search /Groups PrimaryGroupID "$candidate" 2>/dev/null | /usr/bin/grep -Eq '[[:space:]]'; then return 0; fi
  if dscacheutil -q user -a uid "$candidate" 2>/dev/null | /usr/bin/grep -Fq 'name:'; then return 0; fi
  if dscacheutil -q group -a gid "$candidate" 2>/dev/null | /usr/bin/grep -Fq 'name:'; then return 0; fi
  return 1
}

mac_next_identity_id() {
  candidate=45000
  while [ "$candidate" -lt 60000 ]; do
    if ! mac_identity_id_in_use "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$((candidate + 1))
  done
  fail 'no collision-free macOS service identity ID is available'
}

mac_create_record() {
  record=$1
  label=$2
  printf 'HappyHerd is creating the macOS %s record.\n' "$label"
  sudo dscl . -create "$record" || fail "could not create the macOS $label record"
}

mac_create_attribute() {
  record=$1
  attribute=$2
  value=$3
  label=$4
  sudo dscl . -create "$record" "$attribute" "$value" || fail "could not set $attribute on the macOS $label record"
}

mac_disable_password() {
  record=$1
  label=$2
  sudo dscl . -passwd "$record" '*' || fail "could not disable the password on the macOS $label record"
}

case "$install_dir" in ''|'/'|'/opt'|'/Library'|'/Library/Application Support') fail 'resolved install path is unsafe' ;; esac
case "$state_root" in ''|'/'|'/var'|'/var/lib'|'/Library'|'/Library/Application Support') fail 'resolved broker state path is unsafe' ;; esac

temporary=$(/usr/bin/mktemp -d /tmp/happyherd-install.XXXXXX)
root_stage=$(sudo /usr/bin/mktemp -d /var/tmp/happyherd-root-install.XXXXXX)
case "$root_stage" in /var/tmp/happyherd-root-install.*) sudo chmod 700 "$root_stage" ;; *) fail 'administrator staging path is unsafe' ;; esac
completed=0
published=0
had_previous=0
new_service_identity=0
new_tool_identity=0
new_service_group=0
new_service_user=0
new_tool_user=0
new_keyring_credential=0
new_keychain_host=0
new_keychain_state=0
had_state=0
service_definition_existed=0
tool_launcher_config_existed=0
link_created=0
profile_changes_started=0
profile_backup="$temporary/profile-backup"
retain_temporary=0
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$status" -ne 0 ] && [ "$completed" -ne 1 ]; then
    if [ "$platform" = linux ]; then sudo systemctl stop "$service_name" >/dev/null 2>&1 || true; else sudo launchctl bootout system/"$service_name" >/dev/null 2>&1 || true; fi
    if [ "$profile_changes_started" -eq 1 ] \
      && [ -x "$install_dir/native/node" ] \
      && [ -f "$install_dir/service/happyherd-profile-path.mjs" ]; then
      if ! "$install_dir/native/node" "$install_dir/service/happyherd-profile-path.mjs" \
        restore "$owner_home" "$profile_backup"; then
        recovery_root="$owner_home/.happyherd-profile-recovery"
        recovery_dir=''
        if { [ ! -e "$recovery_root" ] && [ ! -L "$recovery_root" ] && mkdir -m 700 "$recovery_root"; } \
          || { [ -d "$recovery_root" ] && [ ! -L "$recovery_root" ]; }; then
          chmod 700 "$recovery_root"
          recovery_dir=$(/usr/bin/mktemp -d "$recovery_root/install-rollback.XXXXXX") || recovery_dir=''
        fi
        if [ -n "$recovery_dir" ] && cp -R "$profile_backup/." "$recovery_dir/"; then
          chmod -R go-rwx "$recovery_dir"
          printf 'happyherd installer: profile recovery data retained at %s\n' "$recovery_dir" >&2
        else
          retain_temporary=1
          printf 'happyherd installer: profile recovery data retained at %s\n' "$profile_backup" >&2
        fi
      fi
    fi
    if [ "$link_created" -eq 1 ] && [ -L "$link_path" ] \
      && [ "$(readlink "$link_path")" = "$install_dir/bin/happyherd" ]; then
      rm -f -- "$link_path"
    fi
    if [ "$published" -eq 1 ] && owned_install "$install_dir"; then sudo rm -rf -- "$install_dir"; fi
    if [ "$had_previous" -eq 1 ] && sudo test -d "$backup"; then sudo mv "$backup" "$install_dir"; fi
    if [ "$service_definition_existed" -eq 1 ] && sudo test -f "$root_stage/service-definition.previous"; then
      sudo cp "$root_stage/service-definition.previous" "$service_definition"
      sudo chown root:"$( [ "$platform" = darwin ] && printf wheel || printf root )" "$service_definition"
      sudo chmod 644 "$service_definition"
    elif [ "$service_definition_existed" -eq 0 ]; then
      sudo rm -f -- "$service_definition"
    fi
    if sudo test -f "$root_stage/service-config.previous"; then
      sudo cp "$root_stage/service-config.previous" "$state_root/broker-service.json"
      sudo chown "$service_user:$service_group" "$state_root/broker-service.json"
      sudo chmod 600 "$state_root/broker-service.json"
    fi
    if [ "$tool_launcher_config_existed" -eq 1 ] && sudo test -f "$root_stage/tool-launcher-config.previous"; then
      sudo cp "$root_stage/tool-launcher-config.previous" "$tool_launcher_config"
      sudo chown root:"$( [ "$platform" = darwin ] && printf wheel || printf root )" "$tool_launcher_config"
      sudo chmod 600 "$tool_launcher_config"
    elif [ "$tool_launcher_config_existed" -eq 0 ]; then
      sudo rm -f -- "$tool_launcher_config"
    fi
    if [ "$platform" = linux ] && [ "$new_keyring_credential" -eq 1 ]; then
      sudo rm -f -- "$keyring_credential"
    fi
    if [ "$platform" = darwin ] && [ "$new_keychain_state" -eq 1 ] && sudo test -x "$keychain_host"; then
      sudo "$keychain_host" --destroy "$owner_uid" "$service_uid" "$service_gid" "$state_root" "$keychain_path" >/dev/null 2>&1 || true
    fi
    if [ "$platform" = darwin ] && [ "$new_keychain_host" -eq 1 ]; then sudo rm -f -- "$keychain_host"; fi
    if [ "$had_previous" -eq 1 ]; then
      if [ "$platform" = linux ]; then sudo systemctl daemon-reload; sudo systemctl enable --now "$service_name" >/dev/null 2>&1 || true; else sudo launchctl bootstrap system "$service_definition" >/dev/null 2>&1 || true; fi
    elif [ "$new_service_identity" -eq 1 ] && [ "$platform" = linux ]; then
      sudo userdel "$service_user" >/dev/null 2>&1 || true
      if [ "$had_state" -eq 0 ]; then sudo rm -rf -- "$state_root"; fi
    fi
    if [ "$new_tool_identity" -eq 1 ] && [ "$platform" = linux ]; then
      sudo userdel "$tool_user" >/dev/null 2>&1 || true
    fi
    if [ "$platform" = linux ] && [ "$new_service_identity" -eq 1 ]; then sudo groupdel "$service_group" >/dev/null 2>&1 || true; fi
    if [ "$platform" = darwin ]; then
      if [ "$new_tool_user" -eq 1 ]; then sudo dscl . -delete "/Users/$tool_user" >/dev/null 2>&1 || true; fi
      if [ "$new_service_user" -eq 1 ]; then sudo dscl . -delete "/Users/$service_user" >/dev/null 2>&1 || true; fi
      if [ "$new_service_group" -eq 1 ]; then sudo dscl . -delete "/Groups/$service_group" >/dev/null 2>&1 || true; fi
      if [ "$had_state" -eq 0 ]; then sudo rm -rf -- "$state_root"; fi
    fi
  fi
  case "$root_stage" in /var/tmp/happyherd-root-install.*) sudo rm -rf -- "$root_stage" ;; esac
  if [ "$retain_temporary" -eq 0 ]; then
    case "$temporary" in /tmp/happyherd-install.*) rm -rf -- "$temporary" ;; esac
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

manifest="$temporary/release-manifest.json"
archive="$temporary/happyherd.tar.gz"
if [ -n "$local_manifest" ]; then
  [ "$(basename "$local_manifest")" = release-manifest.json ] || fail 'local manifest filename must be release-manifest.json'
  [ "$(basename "$local_asset")" = "$asset_name" ] || fail 'local asset filename does not match the installer-baked target asset'
  /bin/cp "$local_manifest" "$manifest"
  /bin/cp "$local_asset" "$archive"
else
  curl --fail --silent --show-error --location "$release_base/release-manifest.json" --output "$manifest"
  curl --fail --silent --show-error --location "$release_base/$asset_name" --output "$archive"
fi
if [ "$platform" = linux ]; then actual_sha=$(/usr/bin/sha256sum "$archive" | /usr/bin/cut -d' ' -f1)
else actual_sha=$(/usr/bin/shasum -a 256 "$archive" | /usr/bin/cut -d' ' -f1); fi
[ "$actual_sha" = "$asset_sha" ] || fail 'downloaded asset failed SHA-256 verification'
actual_size=$(/usr/bin/wc -c < "$archive" | /usr/bin/tr -d ' ')
[ "$actual_size" = "$asset_size" ] || fail 'downloaded asset failed byte-count verification'

root_archive="$root_stage/happyherd.tar.gz"
root_manifest="$root_stage/release-manifest.json"
sudo /usr/bin/install -o root -g "$( [ "$platform" = darwin ] && printf wheel || printf root )" -m 600 "$archive" "$root_archive"
sudo /usr/bin/install -o root -g "$( [ "$platform" = darwin ] && printf wheel || printf root )" -m 600 "$manifest" "$root_manifest"
if [ "$platform" = linux ]; then root_sha=$(sudo /usr/bin/sha256sum "$root_archive" | /usr/bin/cut -d' ' -f1)
else root_sha=$(sudo /usr/bin/shasum -a 256 "$root_archive" | /usr/bin/cut -d' ' -f1); fi
[ "$root_sha" = "$asset_sha" ] || fail 'administrator staging copy changed after verification'
root_size=$(sudo /usr/bin/wc -c "$root_archive" | /usr/bin/awk '{print $1}')
[ "$root_size" = "$asset_size" ] || fail 'administrator staging byte count changed after verification'

archive_list="$root_stage/archive-list.txt"
archive_verbose="$root_stage/archive-verbose.txt"
sudo /bin/sh -c '/usr/bin/tar -tzf "$1" > "$2"' sh "$root_archive" "$archive_list" || fail 'asset archive could not be listed'
LC_ALL=C sudo /usr/bin/awk '
  NF == 0 || length($0) > 240 || $0 !~ /^happyherd\// || $0 ~ /\\/ || $0 ~ /[^ -~]/ { exit 2 }
  { count += 1; path=$0; sub(/\/$/, "", path); n=split(path, parts, "/"); for(i=1;i<=n;i++) if(parts[i]==""||parts[i]=="."||parts[i]=="..") exit 2; key=tolower(path); if(seen[key]++) exit 3 }
  END { if(count < 1 || count > 100000) exit 4 }
' "$archive_list" || fail 'asset archive contains an unsafe, duplicate, or confusable path'
sudo /bin/sh -c 'LC_ALL=C /usr/bin/tar -tvzf "$1" > "$2"' sh "$root_archive" "$archive_verbose" || fail 'asset archive could not be inspected'
sudo /usr/bin/awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" {exit 1}' "$archive_verbose" || fail 'asset archive contains a link or unsupported entry type'
sudo /usr/bin/tar --no-same-owner -xzf "$root_archive" -C "$root_stage"
sudo chown -R root:"$( [ "$platform" = darwin ] && printf wheel || printf root )" "$root_stage/happyherd"
sudo chmod -R go-w "$root_stage/happyherd"
root_node="$root_stage/happyherd/native/node"
sudo test -x "$root_node" || fail 'verified asset is missing its bundled Node runtime'

sudo "$root_node" - "$root_manifest" "$target" "$release_version" "$asset_name" "$asset_sha" "$asset_size" "$source_sha" <<'NODE' || fail 'release manifest failed pinned validation'
const fs=require('node:fs');const [path,target,version,filename,sha,size,source]=process.argv.slice(2);const bytes=fs.readFileSync(path);if(bytes.length>1048576)process.exit(8);const manifest=JSON.parse(bytes.toString('utf8'));if(manifest.schemaVersion!==1||manifest.product!=='HappyHerd'||manifest.version!==version||manifest.sourceSha!==source)process.exit(2);const assets=manifest.assets?.filter((item)=>item.target===target);if(!assets||assets.length!==1)process.exit(3);const asset=assets[0];if(asset.filename!==filename||asset.sha256!==sha||String(asset.sizeBytes)!==size||asset.sourceSha!==source||asset.format!=='tar.gz')process.exit(4);
NODE

HAPPYHERD_EXPECTED_VERSION=$release_version HAPPYHERD_EXPECTED_TARGET=$target HAPPYHERD_EXPECTED_SOURCE=$source_sha \
sudo --preserve-env=HAPPYHERD_EXPECTED_VERSION,HAPPYHERD_EXPECTED_TARGET,HAPPYHERD_EXPECTED_SOURCE "$root_node" - "$root_stage/happyherd/release.json" <<'NODE' || fail 'embedded release receipt failed validation'
const fs=require('node:fs');const path=require('node:path');
const receipt=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));
if(receipt.schemaVersion!==1||receipt.product!=='HappyHerd'||receipt.version!==process.env.HAPPYHERD_EXPECTED_VERSION||receipt.target!==process.env.HAPPYHERD_EXPECTED_TARGET||receipt.sourceSha!==process.env.HAPPYHERD_EXPECTED_SOURCE)process.exit(2);
for(const name of ['nodeRuntime','pythonRuntime','toolLauncher']){
 if(typeof receipt[name]!=='string'||path.isAbsolute(receipt[name])||receipt[name].split('/').some((part)=>!part||part==='.'||part==='..'))process.exit(3);
 if(!fs.statSync(path.join(path.dirname(process.argv[2]),...receipt[name].split('/'))).isFile())process.exit(4);
}
if(process.env.HAPPYHERD_EXPECTED_TARGET.startsWith('darwin-')){
 if(receipt.keychainHost!=='service/happyherd-keychain-broker'||!fs.statSync(path.join(path.dirname(process.argv[2]),receipt.keychainHost)).isFile())process.exit(6);
}
if(!/^3\.(?:1\d|[2-9]\d)\.\d+$/.test(receipt.pythonVersion)||!/^\d{4}\.\d+$/.test(receipt.tzdataVersion))process.exit(5);
NODE

receipt_node=$(sudo "$root_node" -e "process.stdout.write(JSON.parse(require('node:fs').readFileSync(process.argv[1],'utf8')).nodeRuntime)" "$root_stage/happyherd/release.json")
receipt_python=$(sudo "$root_node" -e "process.stdout.write(JSON.parse(require('node:fs').readFileSync(process.argv[1],'utf8')).pythonRuntime)" "$root_stage/happyherd/release.json")
receipt_tool_launcher=$(sudo "$root_node" -e "process.stdout.write(JSON.parse(require('node:fs').readFileSync(process.argv[1],'utf8')).toolLauncher)" "$root_stage/happyherd/release.json")
if [ "$platform" = darwin ]; then receipt_keychain_host=$(sudo "$root_node" -e "process.stdout.write(JSON.parse(require('node:fs').readFileSync(process.argv[1],'utf8')).keychainHost)" "$root_stage/happyherd/release.json"); fi
sudo env -i "$root_stage/happyherd/$receipt_python" -I -X utf8 -c 'from zoneinfo import ZoneInfo;assert ZoneInfo("America/New_York").key=="America/New_York"' || fail 'bundled Python runtime failed before publication'

prepare_trust_roots
if sudo test -e "$install_dir"; then
  owned_install "$install_dir" || fail 'install path exists and is not a recognized HappyHerd installation'

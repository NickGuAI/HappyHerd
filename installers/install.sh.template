  sudo cp "$tool_launcher_config" "$root_stage/tool-launcher-config.previous"
  tool_launcher_config_existed=1
fi

if [ "$platform" = linux ]; then sudo systemctl stop "$service_name" >/dev/null 2>&1 || true; else sudo launchctl bootout system/"$service_name" >/dev/null 2>&1 || true; fi
if sudo test -e "$install_dir"; then sudo mv "$install_dir" "$backup"; had_previous=1; fi
sudo mkdir -p "$(dirname "$install_dir")"
sudo mv "$root_stage/happyherd" "$install_dir"
sudo chmod 4755 "$install_dir/$receipt_tool_launcher"
verify_install_tree "$install_dir" || fail 'published installation lost its administrator trust boundary'
protected_regular "$install_dir/$receipt_python" executable || fail 'published Python runtime is unsafe'
protected_regular "$install_dir/$receipt_tool_launcher" executable || fail 'published isolated tool launcher is unsafe'
protected_regular "$install_dir/runtime/bin/happyherd.mjs" || fail 'published broker entrypoint is unsafe'
protected_regular "$install_dir/service/happyherd-uninstall-managed.mjs" || fail 'published managed-Skill uninstaller is unsafe'
protected_regular "$install_dir/uninstall.sh" executable || fail 'published uninstaller is unsafe'
if [ "$platform" = darwin ]; then protected_regular "$install_dir/$receipt_keychain_host" executable || fail 'published macOS Keychain broker host is unsafe'; fi
published=1

if [ "$platform" = linux ]; then
  sudo -u "$owner_user" mkdir -p "$claude_skills" "$codex_skills" "$bin_dir"
  sudo setfacl -m "u:$service_user:--x" "$owner_home"
  for path in "$owner_home/.claude" "$owner_home/.codex"; do sudo setfacl -m "u:$service_user:r-x" "$path"; done
  for path in "$claude_skills" "$codex_skills"; do sudo setfacl -m "u:$service_user:rwx" "$path"; sudo setfacl -d -m "u:$service_user:rwx" "$path"; done
else
  mkdir -p "$claude_skills" "$codex_skills" "$bin_dir"
  sudo chmod +a "user:$service_user allow search" "$owner_home"
  for path in "$owner_home/.claude" "$owner_home/.codex"; do sudo chmod +a "user:$service_user allow list,search" "$path"; done
  for path in "$claude_skills" "$codex_skills"; do sudo chmod +a "user:$service_user allow list,search,readattr,readextattr,add_file,add_subdirectory,delete_child,file_inherit,directory_inherit" "$path"; done
fi

sudo mkdir -p "$state_root"
sudo chown -R "$service_user:$service_group" "$state_root"
sudo chmod 710 "$state_root"
if [ "$platform" = darwin ]; then
  if sudo test -e '/Library/PrivilegedHelperTools' || sudo test -L '/Library/PrivilegedHelperTools'; then
    protected_directory '/Library/PrivilegedHelperTools' trusted-admin-group || fail 'macOS privileged helper root is unsafe'
  else
    protected_directory /Library || fail '/Library is not an administrator-protected directory'
    sudo /usr/bin/install -d -o root -g wheel -m 755 '/Library/PrivilegedHelperTools'
    protected_directory '/Library/PrivilegedHelperTools' trusted-admin-group || fail 'created macOS privileged helper root is unsafe'
  fi
  if sudo test -e "$keychain_host"; then
    protected_regular "$keychain_host" executable || fail 'existing macOS Keychain broker host is unsafe'
    [ "$(sudo "$keychain_host" --version)" = happyherd-keychain-broker-v1 ] || fail 'existing macOS Keychain broker host has an unsupported identity'
  else
    sudo /usr/bin/install -o root -g wheel -m 755 "$install_dir/$receipt_keychain_host" "$keychain_host"
    new_keychain_host=1
  fi
  if ! sudo test -e "$keychain_path"; then new_keychain_state=1; fi
  printf 'HappyHerd is initializing the headless macOS credential vault.\n'
  sudo "$keychain_host" --initialize "$owner_uid" "$service_uid" "$service_gid" "$state_root" "$keychain_path" \
    || fail 'durable isolated macOS service Keychain initialization failed'
  protected_directory '/Library/Application Support/HappyHerd/Secrets' || fail 'macOS Keychain master root is unsafe'
  [ "$(protected_metadata '/Library/Application Support/HappyHerd/Secrets')" = '0:0:700' ] || fail 'macOS Keychain master root metadata is unsafe'
  protected_directory "$keychain_master_dir" || fail 'macOS Keychain master owner directory is unsafe'
  [ "$(protected_metadata "$keychain_master_dir")" = '0:0:700' ] || fail 'macOS Keychain master owner directory metadata is unsafe'
  protected_regular "$keychain_master_path" || fail 'macOS Keychain unlock master is unsafe'

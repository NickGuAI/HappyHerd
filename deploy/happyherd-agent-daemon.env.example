HAPPY_SERVER_URL=https://happyherd.example.com
HAPPY_WEBAPP_URL=https://happyherd.example.com
HAPPY_HOME_DIR=/var/lib/happyherd-agent-runtime/happy-home
CODEX_HOME=/var/lib/happyherd-agent-runtime/codex-home
HAPPY_DISABLE_CAFFEINATE=1
PATH=/opt/happyherd/current/daemon/bin:/var/lib/happyherd-agent-runtime/.local/bin:/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash

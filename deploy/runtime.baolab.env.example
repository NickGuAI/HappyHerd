# Public routing identity. The existing network route remains unchanged.
HAPPYHERD_DOMAIN=baolab.gehirn.ai
HAPPYHERD_PUBLIC_URL=https://baolab.gehirn.ai
HAPPYHERD_PORT=20001

# Host-owned HappyHerd state, isolated from Herd and the host daemon.
HAPPYHERD_DATA_DIR=/var/lib/happyherd/data
HAPPYHERD_LOG_DIR=/var/log/happyherd
HAPPYHERD_CLI_HOME=/var/lib/happyherd/cli
HAPPYHERD_MASTER_SECRET_FILE=/etc/happyherd/master-secret
HAPPYHERD_OPENAI_API_KEY_FILE=/etc/happyherd/openai-api-key

# Release identity. Deployment replaces the placeholder with an immutable digest.
HAPPYHERD_CONTAINER_NAME=happyherd
HAPPYHERD_IMAGE=ghcr.io/nickguai/happyherd@sha256:REPLACE_WITH_RELEASE_DIGEST

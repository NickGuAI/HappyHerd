SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Detached bootstrap: cron never owns the daemon or its Codex provider
# processes, so release handoff cannot kill an in-flight Discord turn.
@reboot pmai-happyherd-agent /opt/happyherd/current/scripts/start-host-daemon.sh /etc/pmai-discord-agent/daemon.env 2>&1 | /usr/bin/logger -t pmai-happyherd-daemon-bootstrap

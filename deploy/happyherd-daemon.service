[Unit]
Description=HappyHerd host daemon
After=network-online.target happyherd.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
EnvironmentFile=/etc/happyherd/daemon.env
ExecStart=/opt/happyherd/current/daemon/bin/happy.mjs daemon start-sync
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

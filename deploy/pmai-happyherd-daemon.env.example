HAPPY_SERVER_URL=https://happyherd.gehirn.ai
HAPPY_WEBAPP_URL=https://happyherd.gehirn.ai
HAPPY_HOME_DIR=/var/lib/pmai-happyherd-agent/happy-home
CODEX_HOME=/var/lib/pmai-happyherd-agent/codex-home
HAPPY_DISABLE_CAFFEINATE=1
PATH=/opt/happyherd/current/daemon/bin:/var/lib/pmai-happyherd-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash

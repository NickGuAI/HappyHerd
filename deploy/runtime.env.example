# Public routing identity
HAPPYHERD_DOMAIN=happyherd.gehirn.ai
HAPPYHERD_PUBLIC_URL=https://happyherd.gehirn.ai
HAPPYHERD_PORT=20015

# Host-owned state. These paths must never overlap Herd, qmherd, or legacy Happy.
HAPPYHERD_DATA_DIR=/var/lib/happyherd/data
HAPPYHERD_LOG_DIR=/var/log/happyherd
HAPPYHERD_CLI_HOME=/var/lib/happyherd/cli
HAPPYHERD_MASTER_SECRET_FILE=/etc/happyherd/master-secret

# Release identity. Deployment replaces the placeholder with an A6 digest.
HAPPYHERD_CONTAINER_NAME=happyherd
HAPPYHERD_IMAGE=ghcr.io/nickguai/happyherd@sha256:REPLACE_WITH_RELEASE_DIGEST

# Generic HappyHerd Agent bridge configuration. Organization-specific values
# belong in a named example or an operator-owned deployment profile. Secret
# values belong only in the separate mode-0600 files referenced below.
NODE_ENV=production
HAPPY_SERVER_URL=https://happyherd.example.com
HAPPY_HOME_DIR=/var/lib/happyherd-agent-bridge/happy-agent

HAPPYHERD_AGENT_DISCORD_APPLICATION_ID=replace-with-application-id
HAPPYHERD_AGENT_DISCORD_TOKEN_FILE=/etc/happyherd-agent/secrets/discord-token
HAPPYHERD_AGENT_DISCORD_TOKEN_ROTATION_RECEIPT_FILE=/etc/happyherd-agent/secrets/discord-token-rotation.json
HAPPYHERD_AGENT_DISCORD_TOKEN_NOT_BEFORE=2026-01-01T00:00:00.000Z
HAPPYHERD_AGENT_TOOL_MANIFEST_FILE=/etc/happyherd-agent/agent-manifest.json
HAPPYHERD_AGENT_SERVICE_API_URL=https://service.example.com
HAPPYHERD_AGENT_AUTHORIZATION_PATH=/api/internal/discord/authorize
HAPPYHERD_AGENT_ID=example-team-discord
HAPPYHERD_AGENT_SERVICE_SIGNING_SECRET_FILE=/etc/happyherd-agent/secrets/service-signing-secret
HAPPYHERD_AGENT_TRANSPORT_SECRET_FILE=/etc/happyherd-agent/secrets/bridge-transport-secret

HAPPYHERD_AGENT_MACHINE_ID=replace-with-dedicated-machine-id
HAPPYHERD_AGENT_WORKSPACE=/var/lib/happyherd-agent-runtime/workspace
HAPPYHERD_AGENT_COMMANDER_ID=team-agent
HAPPYHERD_AGENT_CODEX_PERMISSION_MODE=read-only
HAPPYHERD_AGENT_CODEX_EFFORT=max
HAPPYHERD_AGENT_STATE_DIR=/var/lib/happyherd-agent-bridge/state

# The loopback listener serves health and the actor-bound Codex broker. A TLS
# reverse proxy may expose only the broker execution endpoint to the service API.
HAPPYHERD_AGENT_HOST=127.0.0.1
HAPPYHERD_AGENT_PORT=3210
HAPPYHERD_AGENT_BROKER_URL=http://happyherd-agent-broker.localhost:3210/mcp
HAPPYHERD_AGENT_ALLOWED_GUILD_IDS=replace-with-guild-id
HAPPYHERD_AGENT_ALLOWED_CHANNEL_IDS=replace-with-channel-id
HAPPYHERD_AGENT_TURN_TIMEOUT_MS=300000

# Public PMAI Discord bridge configuration. Secret values belong in the
# separate mode-0600 files referenced below.
NODE_ENV=production
HAPPY_SERVER_URL=https://happyherd.gehirn.ai
HAPPY_HOME_DIR=/var/lib/pmai-discord-bridge/happy-agent

PMAI_DISCORD_APPLICATION_ID=replace-with-application-id
PMAI_DISCORD_TOKEN_FILE=/etc/pmai-discord-agent/secrets/discord-token
PMAI_DISCORD_TOKEN_ROTATION_RECEIPT_FILE=/etc/pmai-discord-agent/secrets/discord-token-rotation.json
PMAI_ACCESS_API_URL=https://www.pioneeringminds.ai
PMAI_AUTHORIZATION_PATH=/api/internal/discord/authorize
PMAI_BRIDGE_ID=pmai-discord-production
PMAI_SERVICE_SIGNING_SECRET_FILE=/etc/pmai-discord-agent/secrets/pmai-signing-secret
PMAI_BRIDGE_TRANSPORT_SECRET_FILE=/etc/pmai-discord-agent/secrets/bridge-transport-secret

PMAI_HAPPY_MACHINE_ID=replace-with-dedicated-machine-id
PMAI_AGENT_WORKSPACE=/var/lib/pmai-happyherd-agent/workspace
PMAI_COMMANDER_ID=pmai-team-agent
PMAI_CODEX_PERMISSION_MODE=read-only
PMAI_BRIDGE_STATE_DIR=/var/lib/pmai-discord-bridge/state

# The loopback listener serves health and the actor-bound Codex broker. A TLS
# reverse proxy may expose only /internal/discord/execute to the PMAI API.
PMAI_BRIDGE_HOST=127.0.0.1
PMAI_BRIDGE_PORT=3210
PMAI_BROKER_URL=http://pmai-broker.localhost:3210/mcp
PMAI_ALLOWED_GUILD_IDS=replace-with-guild-id
PMAI_ALLOWED_CHANNEL_IDS=replace-with-channel-id
PMAI_TURN_TIMEOUT_MS=300000
